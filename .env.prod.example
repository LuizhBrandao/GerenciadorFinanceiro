# ==============================================================================
# AMBIENTE: PRODUÇÃO (PROD) - ORACLE CLOUD / VM DEDICADA
# Copie este arquivo para .env.prod no servidor de produção
# ATENÇÃO: NUNCA commite senhas reais nem chaves no repositório Git!
# ==============================================================================
SPRING_PROFILES_ACTIVE=prod
PORT=80

# Banco de Dados de Produção (MySQL)
DB_NAME=financeiro_prod_db
DB_ROOT_PASSWORD=substitua_por_uma_senha_root_forte_e_complexa_64chars
DB_USER=financeiro_prod_app
DB_PASSWORD=substitua_por_uma_senha_app_forte_e_complexa_64chars

# Segurança e Autenticação (JWT Secret - Mínimo 256 bits / 32+ caracteres)
JWT_SECRET=gerador_de_chave_aleatoria_com_mais_de_32_caracteres_criptograficos

# Stripe Webhook Secret de Produção (Live Endpoint)
STRIPE_WEBHOOK_SECRET=whsec_live_substitua_pelo_segredo_real_da_stripe
